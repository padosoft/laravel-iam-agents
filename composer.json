{
    "name": "padosoft/laravel-iam-agents",
    "description": "Delegated access for AI agents per Laravel IAM: agent registry, delegation grants con consenso step-up, OAuth2 Token Exchange (RFC 8693) con claim act, intersection PDP (utente ∩ agente), audit stream=delegation.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "iam",
        "ai-agents",
        "delegated-access",
        "token-exchange",
        "rfc8693",
        "oauth2",
        "authorization"
    ],
    "require": {
        "php": "^8.3",
        "league/oauth2-server": "^9.0",
        "padosoft/laravel-iam-contracts": "^1.4",
        "padosoft/laravel-iam-server": "^1.27",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0",
        "padosoft/laravel-rebel-step-up": "^0.2",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "laravel/ai": "^0.11"
    },
    "suggest": {
        "padosoft/laravel-rebel-step-up": "Consenso PSD2-grade con dynamic linking reale (RebelStepUpConsentVerifier) al posto del verifier nativo (^0.2)",
        "laravel/ai": "Correla il contesto di delega al run dell'SDK AI: `invocation_id` e l'hop padre su ogni log e audit record emesso durante il run (^0.11, dove gli eventi di run sono stati introdotti)."
    },
    "autoload": {
        "psr-4": {
            "Padosoft\\Iam\\Agents\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Padosoft\\Iam\\Agents\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Padosoft\\Iam\\Agents\\IamAgentsServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "lint": "pint",
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
